# Aplicação
PORT=3000
PUBLIC_URL=https://seu-dominio-https.example

# Mercado Pago
# Use "test" enquanto estiver executando o roteiro oficial com conta comprador de teste.
# Use "production" somente com credenciais de produção e após a validação do ambiente de teste.
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_STATEMENT_DESCRIPTOR=RELOGIOECIA

# Banco/persistência
DATABASE_URL=
DATA_DIR=

# Administração
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Melhor Envio
MELHORENVIO_ENV=sandbox
MELHORENVIO_ACCESS_TOKEN=
MELHORENVIO_FROM_POSTAL_CODE=
MELHORENVIO_USER_AGENT=

# E-mail
RESEND_API_KEY=
RESEND_FROM=
