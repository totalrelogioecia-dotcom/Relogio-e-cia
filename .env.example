# Aplicação
PORT=3000
PUBLIC_URL=https://seu-dominio-https.example

# Mercado Pago
# Use "test" enquanto estiver executando o roteiro oficial com conta comprador de teste.
# Use "production" somente com credenciais de produção e após a validação do ambiente de teste.
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_STATEMENT_DESCRIPTOR=RELOGIOECIA

# Proteção do checkout
CHECKOUT_RATE_LIMIT_MAX=30
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
COUPON_RESERVATION_MINUTES=60

# Sessão da conta do cliente (use um segredo diferente do painel administrativo)
AUTH_SESSION_SECRET=

# Banco/persistência
DATABASE_URL=
DATA_DIR=

# Administração
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Melhor Envio
MELHORENVIO_ENV=sandbox
# Deixe o token fixo vazio ao usar OAuth; ele existe apenas como compatibilidade.
MELHORENVIO_ACCESS_TOKEN=
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_REDIRECT_URI=https://seu-dominio-https.example/api/melhorenvio/oauth/callback
MELHORENVIO_SCOPES=shipping-calculate users-read
MELHORENVIO_OAUTH_STATE_SECRET=
MELHORENVIO_FROM_POSTAL_CODE=
MELHORENVIO_USER_AGENT=

# E-mail
RESEND_API_KEY=
RESEND_FROM=
